<script>
  function openInspect(name, score, role, snippet, imgUrl) {
    const card = document.getElementById('inspector-card');
    const nameEl = document.getElementById('inspect-name');
    const scoreEl = document.getElementById('inspect-score');
    const roleEl = document.getElementById('inspect-role');
    const snippetEl = document.getElementById('inspect-snippet');
    const avatarWrap = document.getElementById('inspect-avatar-wrap');

    nameEl.textContent = name;
    scoreEl.textContent = score + ' ⭐';
    roleEl.textContent = role + ' • Faithful Steward';
    snippetEl.textContent = '“' + snippet + '”';

    const initials = name.split(' ').map(p => p[0]).join('').substring(0, 2);
    avatarWrap.innerHTML = '<span class="font-headline-sm text-text-primary text-[15px]">' + initials + '</span>';

    card.classList.remove('opacity-60');
    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function dismissInspector() {
    const card = document.getElementById('inspector-card');
    card.classList.add('opacity-60');
  }

  function filterConstellation(type) {
    const pills = document.querySelectorAll('.constellation-pill');
    pills.forEach(p => {
      p.classList.remove('bg-surface-card', 'text-accent-amber');
      p.classList.add('bg-canvas-elevated', 'text-text-secondary');
    });

    const activePill = document.getElementById('filter-' + type);
    if (activePill) {
      activePill.classList.remove('bg-canvas-elevated', 'text-text-secondary');
      activePill.classList.add('bg-surface-card', 'text-accent-amber');
    }

    const nodes = document.querySelectorAll('.constellation-node');
    nodes.forEach(node => {
      const cat = node.getAttribute('data-category');
      if (type === 'all') {
        node.style.opacity = '1';
        node.style.pointerEvents = 'auto';
        node.style.transform = 'scale(1)';
      } else if (type === 'active') {
        if (cat === 'active') {
          node.style.opacity = '1';
          node.style.pointerEvents = 'auto';
          node.style.transform = 'scale(1.05)';
        } else {
          node.style.opacity = '0.25';
          node.style.pointerEvents = 'none';
          node.style.transform = 'scale(0.9)';
        }
      } else if (type === 'new') {
        if (cat === 'new') {
          node.style.opacity = '1';
          node.style.pointerEvents = 'auto';
          node.style.transform = 'scale(1.1)';
        } else {
          node.style.opacity = '0.25';
          node.style.pointerEvents = 'none';
          node.style.transform = 'scale(0.9)';
        }
      }
    });
  }
